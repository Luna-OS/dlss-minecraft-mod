{
  "schemaVersion": 1,
  "id": "radiante-luna",
  "provides": [
    "radiante"
  ],
  "version": "${version}",
  "name": "Radiante (Luna Fork)",
  "description": "Fork of Radiante (by Gabrieli2806) focused on compatibility with other mods. Hardware ray-traced renderer with DLSS, FSR and XeSS running on Minecraft's native Vulkan backend.",
  "authors": [
    "Gabrieli2806"
  ],
  "contributors": [
    "LJIONG",
    "Interstellarss",
    "CaSilicate-dev",
    "Luna (fork maintainer)"
  ],
  "license": "GPL-3.0",
  "icon": "assets/radiante/icon.png",
  "contact": {
    "homepage": "https://github.com/Luna-OS/dlss-minecraft-mod",
    "sources": "https://github.com/Luna-OS/dlss-minecraft-mod",
    "issues": "https://github.com/Luna-OS/dlss-minecraft-mod/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.g2806.radiante.fabric.RadianteFabric"
    ]
  },
  "mixins": [
    "radiante.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://ko-fi.com/gabrieli2806",
        "modmenu.discord": "https://discord.gg/DhBbAzugZ9"
      }
    }
  }
}